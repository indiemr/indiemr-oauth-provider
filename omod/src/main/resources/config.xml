<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">

	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>org.openmrs.module.indiemroauthprovider</package>
	<author>IndiEMR Team</author>
	<description>
		${project.parent.description}
	</description>

	<activator>org.openmrs.module.indiemroauthprovider.IndiemrOauthProviderActivator</activator>

	<require_version>${openmrsPlatformVersion}</require_version>

	<require_modules>
		<require_module>org.openmrs.module.webservices.rest</require_module>
	</require_modules>

	<packagesWithMappedClasses>org.openmrs.module.indiemroauthprovider.model</packagesWithMappedClasses>

	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>

	<!-- Registry ops (link/register/disable a clinic's form) — admin roles. -->
	<privilege>
		<name>Manage Clinic Forms</name>
		<description>Able to link and configure the clinic's Google Forms</description>
	</privilege>

	<!-- Day-to-day relay use (share a form with a patient, read the answers back) — all staff roles. -->
	<privilege>
		<name>Share Clinic Forms</name>
		<description>Able to share a clinic form with a patient and view the responses</description>
	</privilege>

</module>
